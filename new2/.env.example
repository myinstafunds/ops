# ---------------------------------------------------------------------------
# Ops Control Center - local development configuration
#
# Copy to `.env` and adjust. NEVER commit a populated `.env`.
# NEVER place production credentials in this file.
# ---------------------------------------------------------------------------

# --- Core application ------------------------------------------------------
OPS_ENV=development
OPS_TENANT_ID=BPSEC
OPS_DEFAULT_TENANT=BPSEC

# Comma-separated list of allowed CORS origins (no trailing slash).
OPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Host `localhost` when running the API outside docker-compose.
# When running the API inside docker-compose use the service name `db`.
POSTGRES_USER=ops
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ops_control_center
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ops:change-me-locally@localhost:5432/ops_control_center

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotate for every non-local environment.
OPS_JWT_SECRET=dev-only-insecure-secret-replace-me
OPS_JWT_ALGORITHM=HS256
OPS_ACCESS_TOKEN_TTL_MINUTES=60
OPS_REFRESH_TOKEN_TTL_MINUTES=720
OPS_LOGIN_RATE_LIMIT_PER_MINUTE=10
OPS_LOGIN_RATE_LIMIT_LOCKOUT_MINUTES=15

# --- Request limits --------------------------------------------------------
OPS_MAX_BODY_BYTES=1048576
OPS_DEFAULT_PAGE_SIZE=25
OPS_MAX_PAGE_SIZE=100

# --- BRE Identity ----------------------------------------------------------
OPS_AUTH_MODE=bre            # "bre" | "local"
OPS_BRE_BASE_URL=https://bre-identity.example.internal
OPS_BRE_TIMEOUT_SECONDS=10
OPS_BRE_VERIFY_TLS=true
OPS_BRE_TOKEN_LEEWAY_SECONDS=30

# Local development auth. IGNORED unless OPS_AUTH_MODE=local.
# Never enable this mode in staging or production.
OPS_LOCAL_AUTH_ENABLED=true
OPS_LOCAL_AUTH_USERS_JSON=./backend/scripts/local_auth_users.json
OPS_LOCAL_AUTH_MFA_CODE=000000

# --- Case locking ----------------------------------------------------------
OPS_LOCK_TTL_MINUTES=15
OPS_LOCK_HEARTBEAT_SECONDS=300

# --- SLA -------------------------------------------------------------------
# A work item is "due soon" when its remaining time is at or below this value.
OPS_SLA_DUE_SOON_MINUTES=60

# --- Feature flags (write-back is OFF by default - see PRD section 44) -----
OPS_FEATURE_LOS_WRITEBACK=false
OPS_FEATURE_LMS_WRITEBACK=false
OPS_FEATURE_WRITEBACK_KILL_SWITCH=true

# --- Logging / observability ----------------------------------------------
OPS_LOG_LEVEL=INFO
OPS_LOG_FORMAT=json            # json | console
OPS_LOG_SQL=false
